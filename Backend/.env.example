# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy to .env (or set via your host's environment dashboard) and fill in values.
# For local development, copy to .env.development

NODE_ENV=production
PORT=3001

# Supabase (get from https://app.supabase.com → Settings → API → Service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (get from https://dashboard.razorpay.com → Settings → API Keys)
# G.5: Set webhook secret under Razorpay → Settings → Webhooks → Your endpoint
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# G.5: CORS — set to your production frontend URL (no trailing slash)
FRONTEND_URL=https://your-frontend.netlify.app

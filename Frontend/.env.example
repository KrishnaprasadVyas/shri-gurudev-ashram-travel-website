# ─── Frontend Environment Variables ─────────────────────────────────────────
# Copy to .env.local and fill in your values.

# Supabase project credentials (get from https://app.supabase.com → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL
# Set to your backend API deployment URL (e.g. https://api.mavt.in)
VITE_API_BASE_URL=https://api.mavt.in

# Razorpay public key (test keys start with rzp_test_, live keys with rzp_live_)
# G.3: This must be set for the booking payment flow to work
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Demo mode: set to "true" to bypass Supabase and use mock auth (dev only)
VITE_DEMO_AUTH=false
